# The registry and relay, as a service.
#
#   sudo cp cookrew-registry.service /etc/systemd/system/
#   sudo systemctl enable --now cookrew-registry
#
# The bundle is built with (assets first — xterm.js and the site's scripts
# travel inside the bundle as strings, see scripts/registry-assets.mjs):
#   npm run registry:build          # → /tmp/registry.mjs
#
# --origin is the PRODUCT origin: the passkeys' rpId and the name in every
# sentence. In 0.6.0 that host is a static site served elsewhere; this process
# answers on two names of its own and on no other:
#
#   API_ORIGIN       /v1, /v2 and the relay path. No page, no cookie.
#   AUTH_ORIGIN      the sign-in page, and account & security.
#   CONSOLE_ORIGIN   the console, a static site: the one origin whose page may
#                    call the API.
#
# All three or it refuses to start (registry/src/auth-origin.ts). Only --dev
# runs as one host.

[Unit]
Description=Cookrew registry and relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cookrew
Group=cookrew
WorkingDirectory=/opt/cookrew
Environment=API_ORIGIN=https://api.cookrew.dev
Environment=AUTH_ORIGIN=https://auth.cookrew.dev
Environment=CONSOLE_ORIGIN=https://console.cookrew.dev
ExecStart=/usr/bin/node /opt/cookrew/registry.mjs --port 8791 --data /var/lib/cookrew --origin https://cookrew.dev
Restart=always
RestartSec=2

# It holds other people's door records and its own token key. Nothing else on
# the machine needs to read either.
UMask=0077
StateDirectory=cookrew
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cookrew

[Install]
WantedBy=multi-user.target
