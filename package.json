{
  "name": "cookrew",
  "version": "0.5.2",
  "description": "Cookrew — a desktop app for running a crew of AI coding agents. One zoom from your devices down to a single agent, with artifacts, a phone companion and a CLI agents use to reach each other.",
  "main": "out/main/index.js",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cookrew": "./cli/cookrew.mjs",
    "crew": "./cli/cookrew.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "registry:assets": "node scripts/registry-assets.mjs",
    "deeplink:doctor": "node scripts/dev-deeplink-doctor.mjs",
    "registry:build": "node scripts/registry-assets.mjs && esbuild --bundle registry/src/main.ts --format=esm --platform=node --minify --define:__SITE_REF__=\\\"$(git rev-parse HEAD)\\\" --outfile=/tmp/registry.mjs",
    "start": "electron-vite preview",
    "postinstall": "electron-rebuild -f -w node-pty; node scripts/ensure-node-pty.mjs; node scripts/build-cr-listen.mjs",
    "test": "vitest run",
    "test:perf": "vitest run -c vitest.perf.config.ts",
    "perf:eval": "node scripts/perf-eval.mjs",
    "perf:install": "node scripts/perf-eval-install.mjs",
    "daily:run": "node scripts/copilot-daily.mjs",
    "daily:status": "node scripts/copilot-daily.mjs --status",
    "daily:install": "node scripts/copilot-daily-install.mjs",
    "daily:release": "node scripts/copilot-patch-release.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "gate:checkpoints": "node scripts/checkpoint-live-gate.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "install-cli": "node scripts/install-cli.mjs"
  },
  "dependencies": {
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.3.0",
    "electron-updater": "^6.3.9",
    "marked": "^15.0.0",
    "node-pty": "^1.0.0",
    "pinyin-pro": "3.29.5",
    "qrcode-terminal": "^0.12.0",
    "viem": "^2.55.19",
    "werift": "^0.25.1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^3.7.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "acorn": "^8.14.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
